# =========================================================
# PYTHON
# =========================================================

__pycache__/
*.py[cod]
*$py.class

.pytest_cache/
.mypy_cache/
.coverage
htmlcov/


# =========================================================
# VIRTUAL ENVIRONMENT
# =========================================================

.venv/
venv/
env/


# =========================================================
# IDE / OS
# =========================================================

.vscode/
.idea/

.DS_Store
Thumbs.db
desktop.ini


# =========================================================
# FREDDIE MAC DATA
# Do not commit large raw / processed / model datasets
# =========================================================

data/raw/*
data/processed/*
data/model/*
data/_temp/*

*.parquet
*.zip

# Step 1 deterministic regression fixture
!tests/fixtures/mock_loan_month.parquet

# Step 2 deterministic Kaplan-Meier mock result
!results/mock/km_results.parquet

# Step 3 deterministic Cox fixture and mock results
!tests/fixtures/mock_cox_input.parquet
!results/mock/cox_results.parquet
!results/mock/cox_diagnostics.parquet

# Step 4 deterministic R survival::cox.zph mock results
!results/mock/ph_diagnostics.csv
!results/mock/ph_global_diagnostics.csv


# =========================================================
# TEMP FILES
# =========================================================

*.tmp
*.temp
*.tmp.parquet
~$*
*.bak


# =========================================================
# LOGS
# =========================================================

*.log
outputs/logs/


# =========================================================
# LOCAL ARCHIVE / EXPERIMENTS
# =========================================================

archive/


# =========================================================
# OPTIONAL GENERATED FIGURES
# =========================================================

outputs/figures/*.png
outputs/figures/*.jpg
outputs/figures/*.jpeg


# =========================================================
# KEEP DIRECTORY STRUCTURE
# =========================================================

!data/raw/.gitkeep
!data/processed/.gitkeep
!data/model/.gitkeep
!data/_temp/.gitkeep
# =========================================================
# GENERATED AUDIT TABLES
# Keep only compact project summaries in Git
# =========================================================

outputs/tables/*.csv

!outputs/tables/data_audit_2016_2026.csv
!outputs/tables/final_data_validation.csv
!outputs/tables/event_conflict_summary_by_year.csv
!outputs/tables/event_mapping_summary_2016_2026.csv
!outputs/tables/loan_age_duration_audit_by_year.csv
!outputs/tables/survival_duration_summary_2016_2026.csv
!outputs/tables/model_dataset_summary_2016_2026.csv
